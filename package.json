{
  "name": "whizbang",
  "displayName": "Whizbang",
  "description": "Development-time navigation and runtime debugging for Whizbang event-driven applications",
  "version": "0.8.0",
  "publisher": "SoftwareExtravaganza",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "whizbang",
    "event-driven",
    "cqrs",
    "message-flow",
    "distributed-systems"
  ],
  "activationEvents": [
    "onLanguage:csharp",
    "workspaceContains:**/*.csproj"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "whizbang.goToDispatcher",
        "title": "Whizbang: Go to Dispatcher"
      },
      {
        "command": "whizbang.goToReceptor",
        "title": "Whizbang: Go to Receptor"
      },
      {
        "command": "whizbang.goToPerspective",
        "title": "Whizbang: Go to Perspective"
      },
      {
        "command": "whizbang.findMessageUsages",
        "title": "Whizbang: Find Message Usages"
      },
      {
        "command": "whizbang.showFlowDiagram",
        "title": "Whizbang: Show Flow Diagram"
      },
      {
        "command": "whizbang.refreshMessageRegistry",
        "title": "Whizbang: Refresh Message Registry"
      },
      {
        "command": "whizbang.searchDocs",
        "title": "Whizbang: Search Documentation"
      },
      {
        "command": "whizbang.toggleStatusBar",
        "title": "Whizbang: Toggle Status Bar"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == csharp",
          "command": "whizbang.findMessageUsages",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "whizbang.searchDocs",
        "key": "ctrl+k d",
        "mac": "cmd+k d",
        "when": "editorTextFocus"
      },
      {
        "command": "whizbang.goToDispatcher",
        "key": "ctrl+k ctrl+d",
        "mac": "cmd+k cmd+d",
        "when": "editorTextFocus && resourceLangId == csharp"
      },
      {
        "command": "whizbang.goToReceptor",
        "key": "ctrl+k ctrl+r",
        "mac": "cmd+k cmd+r",
        "when": "editorTextFocus && resourceLangId == csharp"
      },
      {
        "command": "whizbang.goToPerspective",
        "key": "ctrl+k ctrl+p",
        "mac": "cmd+k cmd+p",
        "when": "editorTextFocus && resourceLangId == csharp"
      },
      {
        "command": "whizbang.showFlowDiagram",
        "key": "ctrl+k ctrl+f",
        "mac": "cmd+k cmd+f",
        "when": "editorTextFocus && resourceLangId == csharp"
      }
    ],
    "configuration": {
      "title": "Whizbang",
      "properties": {
        "whizbang.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Enable code lens annotations for messages, dispatchers, and receptors"
        },
        "whizbang.enableHoverInfo": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover tooltips showing message flow information"
        },
        "whizbang.messageRegistryPath": {
          "type": "string",
          "default": ".whizbang/message-registry.json",
          "description": "Path to the message registry JSON file (relative to workspace root)"
        },
        "whizbang.autoGenerateRegistry": {
          "type": "boolean",
          "default": true,
          "description": "Automatically generate message registry on build"
        },
        "whizbang.docsBaseUrl": {
          "type": "string",
          "default": "https://whizbang-lib.github.io",
          "description": "Base URL for the Whizbang documentation site"
        },
        "whizbang.docsCacheTtlHours": {
          "type": "number",
          "default": 24,
          "description": "Hours to cache the type documentation feed before refreshing"
        },
        "whizbang.enableDocSearch": {
          "type": "boolean",
          "default": true,
          "description": "Enable documentation search (Cmd+K D)"
        },
        "whizbang.enableTestCoverage": {
          "type": "boolean",
          "default": true,
          "description": "Show test coverage CodeLens for Whizbang types"
        },
        "whizbang.localLibraryPath": {
          "type": "string",
          "default": "",
          "description": "Local path to whizbang library repo for test file navigation"
        },
        "whizbang.libraryRepoUrl": {
          "type": "string",
          "default": "https://github.com/whizbang-lib/whizbang/blob/develop/",
          "description": "Base URL for viewing library source and test files on GitHub"
        },
        "whizbang.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Whizbang Language Server executable. Leave empty for auto-detection."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "esbuild": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "package": "pnpm run esbuild && vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run esbuild",
    "install-local": "pnpm run package && code --install-extension whizbang-0.2.0.vsix",
    "reinstall": "code --uninstall-extension SoftwareExtravaganza.whizbang && pnpm run install-local",
    "sync-banner": "cp ../whizbang/logo/whizbang-banner.txt src/assets/whizbang-banner.txt"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.27.4",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "glob": "^12.0.0",
    "minisearch": "^7.2.0",
    "vscode-languageclient": "^9.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whizbang-lib/whizbang-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/whizbang-lib/whizbang-vscode/issues"
  },
  "homepage": "https://whizba.ng/",
  "license": "MIT"
}
